PORT=3000

# PostgreSQL (usado a partir da Etapa 2)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roteiriza_ja
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME_TEST=roteiriza_ja_test

# Senha do administrador criado pelo seed (troque em produção)
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123

# Segredo dos tokens de login
JWT_SEGREDO=troque-este-segredo

# Chave que as fontes de pedidos enviam no cabeçalho x-chave-fonte
CHAVE_FONTES=chave-de-desenvolvimento

# Porta de saída: endereço de cada fonte de pedidos, pela origem do pedido.
# Origem sem endereço (ex.: MANUAL) não recebe mensagens.
FONTE_URL_SIMULADOR=http://localhost:4000
